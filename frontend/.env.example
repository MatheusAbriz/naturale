# Chave de projeto pública do PostHog (Settings > Project > Project API Key).
# Sem esta chave, a aplicação continua funcionando e nenhuma telemetria é enviada.
VITE_POSTHOG_KEY=phc_sua_chave_publica

# Opcional. Use o host da sua região PostHog ou o domínio de um reverse proxy.
VITE_POSTHOG_HOST=https://us.i.posthog.com
