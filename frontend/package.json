{
  "name": "naturale",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:e2e:all": "playwright test",
    "test:e2e:live": "E2E_USE_REAL_API=true playwright test --project=chromium --project=webkit",
    "test:e2e:coverage": "COVERAGE=true playwright test --project=chromium --project=webkit",
    "test:e2e:coverage:live": "COVERAGE=true E2E_USE_REAL_API=true playwright test --project=chromium --project=webkit",
    "deploy": "yarn test:e2e:live && yarn build && firebase deploy",
    "testing": "firebase emulators:start",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-query": "^5.104.3",
    "@types/styled-components": "^5.1.34",
    "axios": "^1.9.0",
    "dotenv": "^17.2.0",
    "firebase": "^12.1.0",
    "lucide-react": "^0.488.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.5.0",
    "sonner": "^2.0.5",
    "styled-components": "^6.1.19",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "monocart-coverage-reports": "^3.2.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-istanbul": "^9.0.1"
  }
