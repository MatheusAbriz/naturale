# ================= INTEGRAÇÃO MERCADO PAGO =================
# Token do painel de dev (https://www.mercadopago.com.br/developers/panel)
# Em homologação use o token de TESTE (APP_USR-...-TEST... ou OAuth do seller)
MP_ACCESS_TOKEN=APP_USR-APP_USR-7159980513774529-101823-a5bbdaa2d486e20e7cd5339812d95919-2101771365

# Segredo do webhook para validar o header x-signature (painel MP -> Webhooks)
MP_WEBHOOK_SECRET=393137fa7bacdad53811514cdf5e9c5722c3327d7866188c92d8f1686984319e

# URL pública (https) da função que recebe as notificações do MP, ex:
# https://us-central1-naturale-ab59d.cloudfunctions.net/api/subscription/webhook
MP_NOTIFICATION_URL=https://us-central1-naturale-ab59d.cloudfunctions.net/api/subscription/webhook

# URLs de retorno para onde o usuário volta após pagar (podem incluir ?status=)
MP_CHECKOUT_SUCCESS_URL=https://naturale-ab59d.web.app//plans?status=approved
MP_CHECKOUT_FAILURE_URL=https://naturale-ab59d.web.app/plans?status=failure
MP_CHECKOUT_PENDING_URL=https://naturale-ab59d.web.app/plans?status=pending
